# ==============================================================================
# Environment Configuration for LMS Frontend
# ==============================================================================

# Backend API Endpoint
# In production: Set this to your deployed backend URL ending in /api/v1
# Example: https://backend.yourdomain.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Backend Storage URL
# In production: Set this to your deployed backend public storage URL ending in /storage
# Example: https://backend.yourdomain.com/storage
VITE_STORAGE_URL=http://localhost:8000/storage
